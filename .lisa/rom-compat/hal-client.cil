
; One-shot genuine boot HAL test client, using standard bootctl client policy.
(type lisa_bootctl_probe)
(roletype r lisa_bootctl_probe)
(typeattributeset domain (lisa_bootctl_probe))
(typeattributeset halclientdomain (lisa_bootctl_probe))
(typeattributeset hal_bootctl_client (lisa_bootctl_probe))
(type lisa_bootctl_probe_exec)
(roletype object_r lisa_bootctl_probe_exec)
(typeattributeset exec_type (lisa_bootctl_probe_exec))
(typeattributeset file_type (lisa_bootctl_probe_exec))
(typeattributeset vendor_file_type (lisa_bootctl_probe_exec))
(typetransition init lisa_bootctl_probe_exec process lisa_bootctl_probe)
(allow init lisa_bootctl_probe (process (transition rlimitinh siginh)))
(allow init lisa_bootctl_probe_exec (file (read getattr open execute map)))
(allow lisa_bootctl_probe lisa_bootctl_probe_exec (file (entrypoint read getattr open execute map)))
(allow lisa_bootctl_probe init (process (sigchld)))
(allow lisa_bootctl_probe self (process (fork sigchld)))
(allow lisa_bootctl_probe hwbinder_device (chr_file (read write open getattr ioctl map)))
(allow lisa_bootctl_probe hwservicemanager (binder (call transfer)))
(allow hwservicemanager lisa_bootctl_probe (binder (transfer)))
(allow hwservicemanager lisa_bootctl_probe (dir (search)))
(allow hwservicemanager lisa_bootctl_probe (file (read open)))
(allow hwservicemanager lisa_bootctl_probe (process (getattr)))
(allow lisa_bootctl_probe logdw_socket (sock_file (write)))
(allow lisa_bootctl_probe logd (unix_dgram_socket (sendto)))
